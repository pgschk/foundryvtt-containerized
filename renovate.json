{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>pgschk/renovate-config",
    "github>pgschk/renovate-config:fast"
  ],
  "packageRules": [
    {
      "description": "Auto-merge base image digest updates once CI passes; Alpine minor releases (new Node.js versions) stay PRs for review",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["alpine"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ]
}
