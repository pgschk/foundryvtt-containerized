{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>pgschk/renovate-config",
    "github>pgschk/renovate-config:fast"
  ],
  "packageRules": [
    {
      "description": "Stay on Node 24 (container-structure-test expects v24)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Auto-merge base image digest updates once CI passes",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ]
}
